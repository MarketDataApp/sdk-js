{
	"name": "marketdata-sdk",
	"version": "0.0.1",
	"description": "Official TypeScript/JavaScript SDK for the MarketData API.",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:integration": "MARKETDATA_RUN_INTEGRATION_TESTS=true vitest run tests/integration",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src tests",
		"format": "biome check --write src tests",
		"prepublishOnly": "pnpm lint && pnpm typecheck && pnpm exec vitest run && pnpm build"
	},
	"keywords": [
		"marketdata",
		"sdk",
		"api",
		"finance",
		"stocks",
		"options",
		"typescript"
	],
	"author": "MarketData.app",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarketDataApp/sdk-js.git"
	},
	"bugs": {
		"url": "https://github.com/MarketDataApp/sdk-js/issues"
	},
	"homepage": "https://github.com/MarketDataApp/sdk-js#readme",
	"packageManager": "pnpm@10.24.0",
	"dependencies": {
		"dotenv": "^17.2.3",
		"neverthrow": "^8.2.0",
		"p-limit": "^7.2.0",
		"p-retry": "^7.1.1",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@types/node": "^25.0.3",
		"@vitest/coverage-v8": "^4.1.5",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"publint": "^0.3.18",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
