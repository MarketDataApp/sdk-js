# MarketData SDK configuration — copy to .env and fill in.

# Required for authenticated endpoints. Leave unset to run in demo mode (AAPL only).
MARKETDATA_TOKEN=

# Override API base URL (default: https://api.marketdata.app).
# MARKETDATA_BASE_URL=https://api.marketdata.app

# Override API version (default: v1).
# MARKETDATA_API_VERSION=v1

# Logging level: DEBUG, INFO, WARN, ERROR (default: INFO).
# MARKETDATA_LOGGING_LEVEL=INFO

# Default output format: json, csv, internal (default: internal).
# MARKETDATA_OUTPUT_FORMAT=internal

# Default date format on responses: timestamp, unix, spreadsheet.
# MARKETDATA_DATE_FORMAT=timestamp

# Default column subset (comma-separated). Applied when the request omits `columns`.
# MARKETDATA_COLUMNS=symbol,bid,ask

# Include human-readable field names on responses when true.
# MARKETDATA_USE_HUMAN_READABLE=false

# Include header row in CSV output.
# MARKETDATA_ADD_HEADERS=true

# Data mode for paid plans: live, cached, delayed.
# MARKETDATA_MODE=live

# Retry tuning (defaults: 3 retries, 0.5s initial wait, factor 2, max 10s).
# MARKETDATA_MAX_RETRIES=3
# MARKETDATA_RETRY_INITIAL_WAIT=0.5
# MARKETDATA_RETRY_FACTOR=2
# MARKETDATA_RETRY_MAX_WAIT=10

# Set to "true" to run integration tests against the live API.
# MARKETDATA_RUN_INTEGRATION_TESTS=false
